# Copy to .env and fill in. Never commit the real .env file.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here

# Set to FALSE for Google AI Studio (default). Set to TRUE + configure
# GOOGLE_CLOUD_PROJECT/GOOGLE_CLOUD_LOCATION to run against Vertex AI instead.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- App config (pricing_agent/config.py) ---
PRICING_AGENT_MODEL=gemini-3.5-flash-lite
PRICING_AGENT_APP_NAME=freight_pricing_app
PRICING_AGENT_LOG_LEVEL=INFO
